# 复制本文件为 .env（同目录），docker compose 会自动读取。
#
#   cp .env.example .env
#   # 生成强随机 key：
#   sed -i "s/^WB2A_API_KEY=.*/WB2A_API_KEY=$(head -c 24 /dev/urandom | base64 | tr -d '/+=')/" .env
#
# docker-compose.yml 中使用 ${WB2A_API_KEY:-默认值} 插值，故 .env 存在时优先生效。

# ⚠️ 必改：OpenAI 兼容接口的 Bearer 鉴权密钥。留空 = 接口无鉴权（仅限内网）。
WB2A_API_KEY=CHANGE_ME_strong_api_key

# 端口映射与监听（一般不用改）
# WB2A_LISTEN=:7863

# 区域：cn（国内 CodeBuddy）/ global（国际版）
# WB2A_REGION=cn

# 选号策略：credits（优先积分最高）/ expire（优先即将过期）/ roundrobin（负载均衡）
# WB2A_STRATEGY=credits

# 单请求最多尝试几个账号
# WB2A_MAX_ROTATE=3

# 冷却参数
# WB2A_HARD_CREDIT=12h      # 余额/权益不足
# WB2A_SOFT_RATE=60s        # 限流
# WB2A_ERR_THRESHOLD=3      # 累计错误几次进入冷却
# WB2A_ERR_COOLDOWN=10m     # 错误冷却时长

# 上游超时
# WB2A_TIMEOUT_SECONDS=120

# 时区（影响定时签到的触发时刻）
# TZ=Asia/Shanghai
